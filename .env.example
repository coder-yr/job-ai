# .env.example - copy to .env and edit. NEVER commit .env
DATABASE_URL="postgresql://jobpilot:choose-a-strong-password@localhost:5432/jobpilot?schema=public"
# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=""
PORT=4000
LOG_LEVEL=info

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Windows example; forward slashes are fine
DATA_DIR=C:/Users/YOU/AppData/Local/JobPilot
TZ_DEFAULT=Asia/Kolkata

# Honest identification for outbound requests (use a real contact address)
JOBPILOT_UA="JobPilotAI/1.0 (personal, local-only; contact: you@example.com)"
